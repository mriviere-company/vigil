# vigil — example environment file (PLAN.md §6 standard).
#
# Copy to `.env` for local (non-compose) use, or drop these into your shell /
# compose override before `docker compose up`. Every var below is actually
# read by the service noted in its comment — defaults shown are each
# service's own zero-config default (see gateway/internal/config/config.go,
# inference/text/app/config.py, inference/image/app/config.py). Values here
# are dev-only placeholders; never reuse the API_KEYS value in a real
# deployment (see .github/REPO_SETTINGS.md §3).

# --- gateway (gateway/internal/config/config.go) ---------------------------

# Comma-separated "key:tier" pairs; tier is "free" or "pro" (rate-limit
# tiers, see docs/api.md).
API_KEYS=dev-free:free,dev-pro:pro

# Base URL of the text inference service.
TEXT_SERVICE_URL=http://localhost:8001

# Base URL of the image inference service.
IMAGE_SERVICE_URL=http://localhost:8002

# host:port the gateway's HTTP server listens on.
GATEWAY_ADDR=:8080

# Grace period the gateway waits for in-flight requests to finish on shutdown.
SHUTDOWN_TIMEOUT=10s

# Per-request dial timeout to a downstream inference service.
CONNECT_TIMEOUT=500ms

# Total timeout (dial + response) to a downstream, per attempt (retries can
# extend total wall time).
TOTAL_TIMEOUT=2s

# Max retry attempts for a failed downstream call.
MAX_RETRIES=2

# Consecutive downstream failures before a circuit breaker trips open.
CB_FAILURE_THRESHOLD=5

# How long a tripped circuit breaker stays open before probing again.
CB_OPEN_TIMEOUT=10s

# Number of trial requests allowed through while a circuit is half-open.
CB_HALFOPEN_PROBES=1

# Score above which a moderation verdict is "rejected".
REJECT_THRESHOLD=0.85

# Score above which a moderation verdict is "flagged" (must not exceed REJECT_THRESHOLD).
FLAG_THRESHOLD=0.5

# Max concurrent in-flight requests per downstream before backpressure kicks in.
MAX_INFLIGHT=32

# How the gateway sheds load once MAX_INFLIGHT is saturated: "reject" (503
# overloaded) or "pending" (202 pending body, see docs/api.md).
BACKPRESSURE_MODE=reject

# "retry_after" seconds returned in the 202 degraded-mode body (BACKPRESSURE_MODE=pending).
RETRY_AFTER=30

# Append-only, tamper-evident audit log of moderation decisions (one JSON
# line per 200 response; never raw content — see docs/api.md's Audit Log
# section and gateway/internal/audit's package doc). Empty (default) disables
# it entirely: no file is created. Set to a writable path to enable, e.g.
# AUDIT_LOG_PATH=/var/log/vigil/audit.jsonl
AUDIT_LOG_PATH=

# Attach the statement-of-reasons artifact (DSA Art. 17-shaped; see
# docs/api.md) to the public moderation response under "statement_of_reasons".
# Default false: the public response contract stays byte-identical to the
# pre-existing shape unless a caller opts in. The audit log (above) always
# gets the artifact regardless of this setting, when enabled.
SOR_INCLUDE_IN_RESPONSE=false

# --- inference/text (inference/text/app/config.py) --------------------------

# "stub" (no model download, zero-config) or "onnx" (real model).
MODEL_BACKEND=stub

# Path to the ONNX model file; only read when MODEL_BACKEND=onnx.
MODEL_PATH=

# Path to the tokenizer file; only read when MODEL_BACKEND=onnx (text service only).
TOKENIZER_PATH=

# Model version string reported in /predict responses. Default matches the
# quantized multilingual model produced by inference/text/scripts/fetch_model.py
# (unitary/multilingual-toxic-xlm-roberta, FR/EN/+5 more; see benchmarks/README.md
# for the FR-vs-EN comparison against the previous Xenova/toxic-bert backend).
MODEL_VERSION=multilingual-toxic-xlm-r-onnx-int8-1

# Max accepted request body length (characters) for POST /predict.
MAX_CONTENT_LENGTH=10000

# --- inference/image (inference/image/app/config.py) ------------------------

# "stub" (no model download, zero-config) or "onnx" (real model).
MODEL_BACKEND=stub

# Path to the ONNX model file; only read when MODEL_BACKEND=onnx.
MODEL_PATH=

# Model version string reported in /predict responses.
MODEL_VERSION=nsfw-vit-onnx-1

# Max accepted image size (bytes) for POST /predict.
MAX_IMAGE_BYTES=5000000

# Root logger level (image service only — text service does not read this).
LOG_LEVEL=INFO
